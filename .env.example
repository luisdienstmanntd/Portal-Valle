NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_REF=

# Nunca coloque credenciais privilegiadas em variáveis NEXT_PUBLIC_.

